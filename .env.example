# Public client configuration. Publishable keys are intended for client use and are still protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only configuration. Never prefix a secret with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=replace-only-in-a-secure-server-environment
# Phase 1F: provision the matching private database key in the server environment only.
# ELIFORA_COLOR_PLAN_SIGNING_KEY=replace-with-private-local-database-signing-key

# One of: development, staging, pilot, production
ELIFORA_DEPLOYMENT_ENV=development

