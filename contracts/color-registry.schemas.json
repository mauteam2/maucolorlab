{
  "ColorRegistryQuery": {
    "type": "object",
    "properties": {
      "query": {
        "default": "",
        "type": "string",
        "maxLength": 80
      },
      "brand": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,100}$"
      },
      "region": {
        "type": "string",
        "pattern": "^(UNKNOWN|GLOBAL|EU|[A-Z]{2})$"
      },
      "state": {
        "type": "string",
        "enum": [
          "DISCOVERED",
          "SOURCE_COLLECTED",
          "UNDER_REVIEW",
          "VERIFIED",
          "PUBLISHED",
          "REJECTED",
          "SUPERSEDED"
        ]
      },
      "offset": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      },
      "limit": {
        "default": 25,
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "additionalProperties": false
  },
  "ColorRegistryPage": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "total": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "brands": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "regions": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(UNKNOWN|GLOBAL|EU|[A-Z]{2})$"
        }
      },
      "items": {
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "lineId": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            },
            "line": {
              "type": "string"
            },
            "brandId": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,100}$"
            },
            "brand": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "region": {
              "type": "string",
              "pattern": "^(UNKNOWN|GLOBAL|EU|[A-Z]{2})$"
            },
            "state": {
              "type": "string",
              "enum": [
                "DISCOVERED",
                "SOURCE_COLLECTED",
                "UNDER_REVIEW",
                "VERIFIED",
                "PUBLISHED",
                "REJECTED",
                "SUPERSEDED"
              ]
            },
            "lastReviewedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recipeSupport": {
              "type": "boolean"
            },
            "catalogId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shadeCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "developerCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ruleCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,100}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "starts_with",
                    "pattern": "^https:\\/\\/.*"
                  },
                  "title": {
                    "type": "string"
                  },
                  "documentType": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string",
                    "pattern": "^(UNKNOWN|GLOBAL|EU|[A-Z]{2})$"
                  },
                  "language": {
                    "type": "string"
                  },
                  "documentVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "documentDate": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "retrievedAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reviewStatus": {
                    "type": "string",
                    "enum": [
                      "SOURCE_COLLECTED",
                      "UNDER_REVIEW",
                      "VERIFIED",
                      "REJECTED",
                      "SUPERSEDED"
                    ]
                  }
                },
                "required": [
                  "id",
                  "url",
                  "title",
                  "documentType",
                  "region",
                  "language",
                  "documentVersion",
                  "documentDate",
                  "retrievedAt",
                  "sha256",
                  "reviewStatus"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "id",
            "lineId",
            "line",
            "brandId",
            "brand",
            "manufacturer",
            "region",
            "state",
            "lastReviewedAt",
            "recipeSupport",
            "catalogId",
            "shadeCount",
            "developerCount",
            "ruleCount",
            "sources"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "recipeSupport": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "state": {
                    "const": "PUBLISHED"
                  },
                  "catalogId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "region": {
                    "not": {
                      "const": "UNKNOWN"
                    }
                  },
                  "ruleCount": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "recipeSupport": {
                    "const": false
                  }
                }
              },
              "then": {
                "properties": {
                  "catalogId": {
                    "type": "null"
                  },
                  "ruleCount": {
                    "const": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "required": [
      "schemaVersion",
      "total",
      "offset",
      "limit",
      "brands",
      "regions",
      "items"
    ],
    "additionalProperties": false
  }
}
