\ir costing.inc
create temporary table appointment_money(k text primary key,v jsonb);grant all on appointment_money to authenticated;
create function pg_temp.salon(q jsonb) returns jsonb language sql volatile as $$select public.salon_operation('b4000000-0000-4000-8000-000000000111','b4000000-0000-4000-8000-000000000011',q,gen_random_uuid());$$;
create function pg_temp.book_finance(eid uuid,day text) returns jsonb language sql volatile as $$select pg_temp.salon(jsonb_build_object('type','APPOINTMENT_SAVE','mutation_id',gen_random_uuid(),'id',eid,'expected_version',0,'definition',jsonb_build_object('client_id','b4000000-0000-4000-8000-000000000031','service_id','e5000000-0000-4000-8000-000000000801','staff_membership_id','b4000000-0000-4000-8000-000000000111','local_start',day,'utc_offset_minutes',null,'scheduled_duration_minutes',null,'adjustment_reason',null,'notes',null,'status','CONFIRMED')));$$;
create function pg_temp.transition_finance(eid uuid,v bigint,s text) returns jsonb language sql volatile as $$select pg_temp.salon(jsonb_build_object('type','APPOINTMENT_TRANSITION','mutation_id',gen_random_uuid(),'id',eid,'expected_version',v,'status',s,'reason','Controlled completion'));$$;
create function pg_temp.charge_appointment(eid uuid,aid uuid) returns jsonb language sql volatile as $$select pg_temp.finance(jsonb_build_object('type','SERVICE_CHARGE','mutation_id',gen_random_uuid(),'id',eid,'appointment_id',aid,'reason','Authoritative completed service'));$$;
set local role authenticated;
select is(pg_temp.salon(jsonb_build_object('type','HOURS_SAVE','mutation_id',gen_random_uuid(),'expected_version',0,'days',(select jsonb_agg(jsonb_build_object('day',d,'closed',false,'opens',540,'closes',1080)) from generate_series(1,7) d)))#>>'{data,version}','1','actual salon hours initialized');
select ok(pg_temp.salon(jsonb_build_object('type','STAFF_SAVE','mutation_id',gen_random_uuid(),'membership_id','b4000000-0000-4000-8000-000000000111','expected_version',0,'definition',jsonb_build_object('display_name','Synthetic professional','active',true,'bookable',true,'working_capacity',null,'notes',null,'competencies','[]'::jsonb,'shifts',(select jsonb_agg(jsonb_build_object('day',d,'type','SHIFT','starts',540,'ends',1080)) from generate_series(1,7) d)))) ? 'data','actual staff initialized');
insert into appointment_money values('service',jsonb_build_object('type','SERVICE_SAVE','mutation_id',gen_random_uuid(),'id','e5000000-0000-4000-8000-000000000801','expected_version',0,'definition',jsonb_build_object('name','Stored salon service','category','CARE','description',null,'organization_wide',false,'base_duration_minutes',60,'buffer_before_minutes',0,'buffer_after_minutes',0,'base_price',1000,'tax_rate',20,'tax_inclusive',false,'requires_colorlab',false,'requires_hair_passport',false,'requires_precheck',false,'active',true,'eligible_membership_ids',jsonb_build_array('b4000000-0000-4000-8000-000000000111'),'capabilities','[]'::jsonb,'resources','[]'::jsonb)));
select ok(pg_temp.salon((select v from appointment_money where k='service')) ? 'data','actual service snapshot initialized');
select is(pg_temp.book_finance('e5000000-0000-4000-8000-000000000811','2026-10-20T10:00')#>>'{data,status}','CONFIRMED','first authoritative appointment booked');
select is(pg_temp.book_finance('e5000000-0000-4000-8000-000000000812','2026-10-21T10:00')#>>'{data,status}','CONFIRMED','second authoritative appointment booked');
